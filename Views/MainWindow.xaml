<Window x:Class="SubtitleOverlay.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subtitle Overlay — Contrôles" Width="700" Height="790"
        MinWidth="600" MinHeight="560" WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock Text="Subtitle Overlay" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="Lecture audio et sous-titres toujours visibles" Foreground="DimGray" Margin="0,3,0,12"/>
        <WrapPanel>
          <Button Content="Ouvrir un audio" Command="{Binding OpenAudioCommand}"/>
          <Button Content="Ouvrir un SRT" Command="{Binding OpenSrtCommand}"/>
        </WrapPanel>
        <DockPanel Margin="4,6,4,0"><TextBlock Text="Audio : " FontWeight="SemiBold"/><TextBlock Text="{Binding AudioName}" TextTrimming="CharacterEllipsis"/></DockPanel>
        <DockPanel Margin="4,3,4,10"><TextBlock Text="SRT : " FontWeight="SemiBold"/><TextBlock Text="{Binding SubtitleName}" TextTrimming="CharacterEllipsis"/></DockPanel>
      </StackPanel>

      <Border Grid.Row="1" Background="#FFF2F3F5" CornerRadius="8" Padding="10" Margin="0,0,0,10">
        <StackPanel>
          <WrapPanel HorizontalAlignment="Center">
            <Button Content="− 10 s" Command="{Binding BackwardCommand}"/>
            <Button Content="{Binding PlayPauseLabel}" Command="{Binding PlayPauseCommand}" MinWidth="90"/>
            <Button Content="Arrêt" Command="{Binding StopCommand}"/>
            <Button Content="+ 10 s" Command="{Binding ForwardCommand}"/>
          </WrapPanel>
          <Slider Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position}"
                  PreviewMouseLeftButtonDown="Progress_MouseDown"
                  PreviewMouseLeftButtonUp="Progress_MouseUp"
                  LostMouseCapture="Progress_LostMouseCapture"/>
          <DockPanel>
            <TextBlock Text="{Binding CurrentTime}"/>
            <TextBlock Text="{Binding TotalTime}" HorizontalAlignment="Right"/>
          </DockPanel>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Volume" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1"
                    Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0}%}"
                       VerticalAlignment="Center" TextAlignment="Right"/>
          </Grid>
        </StackPanel>
      </Border>

      <GroupBox Grid.Row="2" Header="Synchronisation des sous-titres" Margin="0,0,0,10">
        <StackPanel Margin="8">
          <WrapPanel>
            <Button Content="− 500 ms" Command="{Binding OffsetMinusCommand}"/>
            <Button Content="+ 500 ms" Command="{Binding OffsetPlusCommand}"/>
            <Button Content="Tout remettre à zéro" Command="{Binding OffsetResetCommand}"/>
            <TextBox Text="{Binding SubtitleOffsetMs, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="8,3"/>
            <TextBlock Text="{Binding OffsetDisplay}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock Text=" · Dérive : " VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock Text="{Binding DriftDisplay}" VerticalAlignment="Center" FontWeight="SemiBold"/>
          </WrapPanel>

          <Separator Margin="3,8"/>
          <TextBlock Text="Pausez au début d’une phrase entendue, puis choisissez ci-dessous la phrase SRT correspondante."
                     TextWrapping="Wrap" Foreground="DimGray" Margin="3,0,3,6"/>
          <Border Background="#FFF2F3F5" CornerRadius="6" Padding="9">
            <StackPanel>
              <TextBlock Text="{Binding SyncCandidateTime}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding SyncCandidateText}" TextWrapping="Wrap" MaxHeight="62"/>
            </StackPanel>
          </Border>
          <WrapPanel Margin="0,5,0,0">
            <Button Content="◀ Phrase précédente" Command="{Binding PreviousSyncCandidateCommand}"/>
            <Button Content="Phrase suivante ▶" Command="{Binding NextSyncCandidateCommand}"/>
            <Button Content="Point A — caler ici" Command="{Binding ResyncCommand}"
                    ToolTip="Corrige immédiatement le décalage et mémorise le premier point."/>
            <Button Content="Point B — corriger la dérive" Command="{Binding CorrectDriftCommand}"
                    ToolTip="À utiliser plus loin dans l’audio après avoir défini le Point A."/>
          </WrapPanel>
          <TextBlock Text="{Binding SyncStatus}" TextWrapping="Wrap" Foreground="#FF315B7D" Margin="3,5,3,0"/>
        </StackPanel>
      </GroupBox>

      <GroupBox Grid.Row="3" Header="Overlay" Margin="0,0,0,10">
        <StackPanel Margin="8">
          <WrapPanel>
            <Button Content="Afficher / masquer" Command="{Binding ToggleOverlayCommand}"/>
            <Button Content="{Binding ClickThroughLabel}" Command="{Binding ToggleClickThroughCommand}"/>
          </WrapPanel>
          <WrapPanel>
            <TextBlock Text="Position :" Margin="4" VerticalAlignment="Center"/>
            <Button Content="Haut" Command="{Binding PositionOverlayCommand}" CommandParameter="Haut"/>
            <Button Content="Centre" Command="{Binding PositionOverlayCommand}" CommandParameter="Centre"/>
            <Button Content="Bas" Command="{Binding PositionOverlayCommand}" CommandParameter="Bas"/>
          </WrapPanel>
        </StackPanel>
      </GroupBox>

      <GroupBox Grid.Row="4" Header="Apparence" Margin="0,0,0,10">
        <Grid Margin="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Police" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding SystemFontFamilies}"
                    SelectedValuePath="Source" SelectedValue="{Binding FontFamily}" IsEditable="True" Margin="3"/>
          <TextBlock Grid.Row="1" Text="Taille du texte" VerticalAlignment="Center"/>
          <Slider Grid.Row="1" Grid.Column="1" Minimum="14" Maximum="72" Value="{Binding FontSize}"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding FontSize, StringFormat={}{0:F0}}" TextAlignment="Right"/>
          <TextBlock Grid.Row="2" Text="Opacité du fond" VerticalAlignment="Center"/>
          <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding BackgroundOpacity}"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}" TextAlignment="Right"/>
          <TextBlock Grid.Row="3" Text="Opacité du texte" VerticalAlignment="Center"/>
          <Slider Grid.Row="3" Grid.Column="1" Minimum="0.1" Maximum="1" Value="{Binding TextOpacity}"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding TextOpacity, StringFormat={}{0:P0}}" TextAlignment="Right"/>
          <TextBlock Grid.Row="4" Text="Couleur du texte" VerticalAlignment="Center"/>
          <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding TextColor, UpdateSourceTrigger=LostFocus}" Margin="3"/>
          <TextBlock Grid.Row="5" Text="Couleur du fond" VerticalAlignment="Center"/>
          <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding BackgroundColor, UpdateSourceTrigger=LostFocus}" Margin="3"/>
          <CheckBox Grid.Row="6" Grid.ColumnSpan="2" Content="Ombre autour du texte" IsChecked="{Binding TextShadow}" Margin="3"/>
          <CheckBox Grid.Row="7" Grid.ColumnSpan="2" Content="Mode sans bordure" IsChecked="{Binding Borderless}" Margin="3"/>
        </Grid>
      </GroupBox>

      <TextBlock Grid.Row="5" Text="La fermeture réduit l’application dans la zone de notification."
                 Foreground="DimGray" HorizontalAlignment="Center" Margin="4"/>
      <Button Grid.Row="6" Content="Quitter l’application" Command="{Binding ExitCommand}" HorizontalAlignment="Right"/>
    </Grid>
  </ScrollViewer>
</Window>
