<Window x:Class="SubtitleOverlay.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sous-titres" Topmost="True" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" ShowInTaskbar="False">
  <Grid MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
    <Border x:Name="OverlayBorder" CornerRadius="14"
            Background="{Binding BackgroundBrush}" Opacity="{Binding BackgroundOpacity}"/>
    <Grid Margin="24,16">
      <TextBlock x:Name="ShadowText" Text="{Binding CurrentSubtitle}" TextWrapping="Wrap"
                 TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                 FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}" Foreground="Black"
                 Opacity="{Binding TextOpacity}" Margin="2,2,0,0"/>
      <TextBlock Text="{Binding CurrentSubtitle}" TextWrapping="Wrap"
                 TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                 FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}"
                 Foreground="{Binding TextBrush}" Opacity="{Binding TextOpacity}"/>
    </Grid>
  </Grid>
</Window>
